-- Create ScrollingFrame
local ScrollingFrame = Instance.new("ScrollingFrame", PiggyGui)
ScrollingFrame.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
ScrollingFrame.Position = UDim2.new(0.0800000057, 0, 0.5, 0)  -- Move to the right
ScrollingFrame.Size = UDim2.new(0, 300, 0, 400)  -- Larger size
ScrollingFrame.Visible =  false  -- Initially hidden
ScrollingFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0) -- Required fallback
ScrollingFrame.Active = true


-- Make ScrollingFrame draggable
local draggingFrame
local dragInputFrame
local dragStartFrame
local startPosFrame

local function updateFrame(input)
    local delta = input.Position - dragStartFrame
    ScrollingFrame.Position = UDim2.new(startPosFrame.X.Scale, startPosFrame.X.Offset + delta.X, startPosFrame.Y.Scale, startPosFrame.Y.Offset + delta.Y)
end

ScrollingFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFrame = true
        dragStartFrame = input.Position
        startPosFrame = ScrollingFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFrame = false
            end
        end)
    end
end)

ScrollingFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInputFrame = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInputFrame and draggingFrame then
        updateFrame(input)
    end
end)


-- Print Path
local function getFullPath(instance)
	local path = instance.Name
	local parent = instance.Parent
	while parent and parent ~= game do
		path = parent.Name .. "." .. path
		parent = parent.Parent
	end
	return path
end

